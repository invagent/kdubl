            <!--            税码是S的所有不含税金额的和-->
            <cbc:TaxableAmount currencyID="EUR">100</cbc:TaxableAmount> <!-- BT-116 -->
            <!--            税码是S的所有税额的和-->
            <cbc:TaxAmount currencyID="EUR">21</cbc:TaxAmount> <!-- BT-117 -->
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID> <!-- BT-118 -->
                <cbc:Percent>21</cbc:Percent> <!-- BT-119 -->
