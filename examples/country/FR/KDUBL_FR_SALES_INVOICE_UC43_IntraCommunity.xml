<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  KDUBL 2.1 示例文件 — 法国境内共同体供货上报 UC43（Flux 10.1）
  对应 PUF 示例：PUF_France_UC43_IntraCommunitySupply_InvoiceReport.xml

  法国卖方（Kingdee Test Supplier FR）→ 德国买方（Maschinenbau München GmbH）
  上报类型：INVOICE（B2B 共同体供货，VAT 类别 K，0% 豁免）
  AccountType：RECEIVABLE（销项）
  场景：#BAR#B2BINT — 国际 B2B 上报（不适用 e-invoicing，仅 e-reporting）
-->
<Invoice
    xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns:kdubl="urn:piaozone.com:ubl-2.1-customizations:v1.0">

    <cbc:CustomizationID>urn:piaozone.com:ubl-2.1-customizations:v1.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:piaozone.com:profile:bill:v1.0</cbc:ProfileID>
    <cbc:ID>FR-INV-2026-0804001</cbc:ID>
    <cbc:IssueDate>2026-08-11</cbc:IssueDate>
    <cbc:DueDate>2026-09-10</cbc:DueDate>
    <!-- 380=商业发票；@name=BT-23 业务流程分类码(货物用 B1,Pagero 据此推导 classification type) -->
    <cbc:InvoiceTypeCode name="B1">380</cbc:InvoiceTypeCode>
    <!-- #BAR#B2BINT：国际 B2B 上报标识（法国规则 BR-FR-20） -->
    <cbc:Note>#AAB#Pas d'escompte accordé</cbc:Note>
    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>
    <cbc:BuyerReference>DE-BUYER-REF-2026-043</cbc:BuyerReference>

    <!-- 业务场景码：B2B 国际（通道路由用） -->
    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">B2B</cbc:ID>
        <cbc:DocumentType>InvoiceContext</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- KDUBL-EXT-TaxReportTransactionType：上报交易类型（B2B）→ PUF transactionType -->
    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">B2B</cbc:ID>
        <cbc:DocumentType>TaxReportTransactionType</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- 采购订单引用 -->
    <cac:AdditionalDocumentReference>
        <cbc:ID>PO-2026-DE-043</cbc:ID>
        <cbc:DocumentType>OrderReference</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- KDUBL-EXT-TaxReportEntryType -->
    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">INVOICE</cbc:ID>
        <cbc:DocumentType>TaxReportEntryType</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- KDUBL-EXT-TaxReportTransmissionType -->
    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">ORIGINAL</cbc:ID>
        <cbc:DocumentType>TaxReportTransmissionType</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- KDUBL-EXT-TaxReportPeriodStart -->
    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">2026-08-11</cbc:ID>
        <cbc:DocumentType>TaxReportPeriodStart</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- KDUBL-EXT-TaxReportPeriodEnd -->
    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">2026-08-20</cbc:ID>
        <cbc:DocumentType>TaxReportPeriodEnd</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- BG-4 销售方（Kingdee Test Supplier FR，含 SIRET） -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <!-- 场所标识：FR:SIRET(14 位 = SIREN + NIC) type=OTHER，ICD 0009。
                 法人标识是下方 PartyLegalEntity/CompanyID 的 SIREN，两者不可互换。
                 法国上报(Flux 10.1)不使用 SIRET，转换时本节点整体丢弃。 -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="FR:SIRET">10433218410018</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Kingdee Test Supplier FR</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Zone Industrielle</cbc:StreetName>
                <cbc:CityName>Paris</cbc:CityName>
                <cbc:PostalZone>75001</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>FR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID schemeID="FR:VAT">FR68104332184</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Kingdee Test Supplier FR</cbc:RegistrationName>
                <!-- BT-30 法人注册标识：FR:SIREN(9 位) type=LEGAL，上报映射 ICD 0002 -->
                <cbc:CompanyID schemeID="FR:SIREN">104332184</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- BG-7 购买方（德国买方） -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PartyName>
                <cbc:Name>Maschinenbau München GmbH</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Industriestraße 42</cbc:StreetName>
                <cbc:CityName>München</cbc:CityName>
                <cbc:PostalZone>80331</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>DE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID schemeID="DE:VAT">DE100000001</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Maschinenbau München GmbH</cbc:RegistrationName>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <cac:Delivery>
        <cbc:ActualDeliveryDate>2026-08-11</cbc:ActualDeliveryDate>
        <cac:DeliveryLocation>
            <cac:Address>
                <cbc:StreetName>Industriestraße 42</cbc:StreetName>
                <cbc:CityName>München</cbc:CityName>
                <cbc:PostalZone>80331</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>DE</cbc:IdentificationCode>
                </cac:Country>
            </cac:Address>
        </cac:DeliveryLocation>
    </cac:Delivery>

    <!-- VAT 类别 K：境内共同体供货，0% 豁免，VATEX-EU-IC -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">75000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">0.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <!-- K=境内共同体供货 -->
                <cbc:ID>K</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cbc:TaxExemptionReasonCode>VATEX-EU-IC</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>Exonération de TVA - Livraison intracommunautaire - article 138 Directive 2006/112/CE</cbc:TaxExemptionReason>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="EUR">75000.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="EUR">75000.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="EUR">75000.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="EUR">75000.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">2</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">50000.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Presse hydraulique industrielle 200 tonnes, modèle PH-200X</cbc:Description>
            <cbc:Name>Presse hydraulique PH-200X</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>K</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">25000.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="C62">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

    <cac:InvoiceLine>
        <cbc:ID>2</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">25000.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Robot de soudure automatisé 6 axes, modèle RS-600</cbc:Description>
            <cbc:Name>Robot de soudure RS-600</cbc:Name>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>K</cbc:ID>
                <cbc:Percent>0.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">25000.00</cbc:PriceAmount>
            <cbc:BaseQuantity unitCode="C62">1</cbc:BaseQuantity>
        </cac:Price>
    </cac:InvoiceLine>

</Invoice>
