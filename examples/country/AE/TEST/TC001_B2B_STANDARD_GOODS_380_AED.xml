<?xml version="1.0" encoding="UTF-8"?>
<!--
  测试用例 TC-001
  标题：新增+B2B标准税率货物发票+必填字段齐全+提交成功
  场景：单据类型=380，交易类型标志位BTAE-02=00000000，单据货币=AED，买卖双方及发票行必填字段齐全
  预期：接口返回成功状态码及唯一标识符(BTAE-07 UUID)，生成的发票单据号、开票日期与请求一致
  优先级：P0
-->
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
         xmlns:kdubl="urn:piaozone:ExtensionComponent:1.0">
    <cbc:CustomizationID>urn:piaozone.com:ubl-2.1-customizations:v1.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:piaozone.com:profile:bill:v1.0</cbc:ProfileID>
    <!-- IBT-001: Document number -->
    <cbc:ID>TC001-AE-INV-2026-001</cbc:ID>
    <!-- IBT-002: Issue date -->
    <cbc:IssueDate>2026-09-09</cbc:IssueDate>
    <!-- IBT-009: Payment due date -->
    <cbc:DueDate>2026-10-09</cbc:DueDate>
    <!-- IBT-003: Document type code=380 (Invoice); BTAE-02=00000000 -->
    <cbc:InvoiceTypeCode name="00000000">380</cbc:InvoiceTypeCode>
    <!-- IBT-005: Document currency code = AED -->
    <cbc:DocumentCurrencyCode>AED</cbc:DocumentCurrencyCode>

    <!-- Seller (AccountingSupplierParty) -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <!-- PEPPOL endpoint (0235 = AE:TIN, TIN = first 10 digits of TRN) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="PEPPOL">0235:1005556667</cbc:ID>
            </cac:PartyIdentification>
            <!-- AE:LRA: Seller licensing/registration authority name (BTAE-12) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="AE:LRA">Department of Economic Development - Dubai</cbc:ID>
            </cac:PartyIdentification>
            <!-- IBT-035/037/039/040: Seller address -->
            <cac:PostalAddress>
                <cbc:StreetName>Sheikh Zayed Road, Office 1201</cbc:StreetName>
                <cbc:CityName>Dubai</cbc:CityName>
                <!-- IBT-039: Country subentity (required when country=AE); DXB = Dubai -->
                <cbc:CountrySubentity>DXB</cbc:CountrySubentity>
                <cac:Country>
                    <!-- IBT-040 -->
                    <cbc:IdentificationCode>AE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <!-- IBT-031: Seller VAT identifier (TRN: 15 digits, starts with 1, ends with 03) -->
            <cac:PartyTaxScheme>
                <cbc:CompanyID>100555666700003</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <!-- IBT-027/028/030: Seller legal entity -->
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Acme Trading LLC</cbc:RegistrationName>
                <!-- IBT-030: Registration/Identification Number; BTAE-15=AE:TL (Trade License) -->
                <cbc:CompanyID schemeID="AE:TL">CN-1234567</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- Buyer (AccountingCustomerParty) - B2B: buyer has TRN -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <!-- PEPPOL endpoint (0235 = AE:TIN, TIN = first 10 digits of buyer TRN) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="PEPPOL">0235:1007778889</cbc:ID>
            </cac:PartyIdentification>
            <!-- AE:LRA: Buyer licensing/registration authority name (BTAE-11) -->
            <cac:PartyIdentification>
                <cbc:ID schemeID="AE:LRA">Abu Dhabi Department of Economic Development</cbc:ID>
            </cac:PartyIdentification>
            <!-- IBT-050/052/054/055: Buyer address -->
            <cac:PostalAddress>
                <cbc:StreetName>Khalifa Street, Tower 5</cbc:StreetName>
                <cbc:CityName>Abu Dhabi</cbc:CityName>
                <!-- IBT-054: Country subentity (required when country=AE); AUH = Abu Dhabi -->
                <cbc:CountrySubentity>AUH</cbc:CountrySubentity>
                <cac:Country>
                    <!-- IBT-055 -->
                    <cbc:IdentificationCode>AE</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <!-- IBT-048: Buyer VAT identifier (TRN: 15 digits, starts with 1, ends with 03) -->
            <cac:PartyTaxScheme>
                <cbc:CompanyID>100777888900003</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <!-- IBT-044/045/047: Buyer legal entity -->
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Burj Holdings PJSC</cbc:RegistrationName>
                <!-- IBT-047: Buyer Registration Number; BTAE-16=AE:TL -->
                <cbc:CompanyID schemeID="AE:TL">CN-1001003</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- IBT-081/083: Payment means -->
    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <cbc:ID>AE070331234567890123456</cbc:ID>
            <cac:FinancialInstitutionBranch>
                <cbc:ID>EBILAEAD</cbc:ID>
            </cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>

    <!-- IBT-110/117/118/119: Tax total (standard rate S = 5%) -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="AED">50.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="AED">1000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="AED">50.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <!-- IBT-118: Tax category code = S (Standard rate) -->
                <cbc:ID>S</cbc:ID>
                <!-- IBT-119: Tax category rate = 5.00% -->
                <cbc:Percent>5.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <!-- IBT-106/109/112/115: Legal monetary total -->
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="AED">1000.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="AED">1000.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="AED">1050.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="AED">1050.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- Invoice line (IBG-25): GOODS, HS classification, standard rate S=5% -->
    <cac:InvoiceLine>
        <!-- IBT-126: Invoice line identifier -->
        <cbc:ID>1</cbc:ID>
        <!-- IBT-129/130: Invoiced quantity + unit -->
        <cbc:InvoicedQuantity unitCode="EA">10</cbc:InvoicedQuantity>
        <!-- IBT-131: Line net amount -->
        <cbc:LineExtensionAmount currencyID="AED">1000.00</cbc:LineExtensionAmount>
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="AED">50.00</cbc:TaxAmount>
        </cac:TaxTotal>
        <cac:Item>
            <!-- IBT-153: Item name -->
            <cbc:Name>Industrial pump</cbc:Name>
            <!-- IBT-158/158-1: Item classification; scheme=HS (required for GOODS) -->
            <cac:CommodityClassification>
                <!-- BTAE-13: Item type = GOODS -->
                <cbc:CommodityCode>G</cbc:CommodityCode>
                <cbc:ItemClassificationCode listID="HS">8413.70.10</cbc:ItemClassificationCode>
            </cac:CommodityClassification>
            <!-- IBT-151: Invoiced item tax category code -->
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>5.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <!-- IBT-146: Item net price -->
            <cbc:PriceAmount currencyID="AED">100.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
