<?xml version="1.0" encoding="UTF-8"?>
<!--
  测试用例 TC-004
  标题：单据货币=USD+提供汇率(≤6位小数)及AED换算金额+提交成功
  场景：文档货币=USD，汇率(BTAE-04)=3.672500，提供含税总额AED换算(BTAE-20)、行AED税额(BTAE-08)、行AED金额(BTAE-10)
  预期：接口返回成功，AED换算金额=原币金额×汇率，核算一致
  优先级：P0
-->
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
         xmlns:kdubl="urn:piaozone:ExtensionComponent:1.0">
    <!-- UBLExtensions must be first child per UBL 2.1 XSD -->
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionAgencyName>Piaozone</ext:ExtensionAgencyName>
            <ext:ExtensionContent>
                <kdubl:PiaozoneExtension>
                    <!-- BTAE-20: AED换算金额 (LegalMonetaryTotal AED) -->
                    <kdubl:TaxCurrencyLegalMonetaryTotal>
                        <cbc:TaxExclusiveAmount currencyID="AED">3672.50</cbc:TaxExclusiveAmount>
                        <cbc:TaxInclusiveAmount currencyID="AED">3856.13</cbc:TaxInclusiveAmount>
                        <cbc:PayableAmount currencyID="AED">3856.13</cbc:PayableAmount>
                    </kdubl:TaxCurrencyLegalMonetaryTotal>
                    <!-- BTAE-08: 行AED税额 -->
                    <kdubl:TaxTotalExtensions>
                        <kdubl:TaxTotalExtension>
                            <kdubl:TaxSubtotalExtensions>
                                <kdubl:TaxSubtotalExtension>
                                    <kdubl:TaxCurrencyTaxAmount currencyID="AED">183.63</kdubl:TaxCurrencyTaxAmount>
                                </kdubl:TaxSubtotalExtension>
                            </kdubl:TaxSubtotalExtensions>
                        </kdubl:TaxTotalExtension>
                    </kdubl:TaxTotalExtensions>
                    <!-- BTAE-10: 行AED金额 -->
                    <kdubl:LineExtensions>
                        <kdubl:LineExtension>
                            <kdubl:LineID>1</kdubl:LineID>
                            <kdubl:TaxCurrencyTaxInclusiveLineExtensionAmount currencyID="AED">3856.13</kdubl:TaxCurrencyTaxInclusiveLineExtensionAmount>
                            <kdubl:TaxCurrencyLineExtensionAmount currencyID="AED">3672.50</kdubl:TaxCurrencyLineExtensionAmount>
                            <kdubl:TaxCurrencyPriceAmount currencyID="AED">367.25</kdubl:TaxCurrencyPriceAmount>
                        </kdubl:LineExtension>
                    </kdubl:LineExtensions>
                </kdubl:PiaozoneExtension>
            </ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:CustomizationID>urn:piaozone.com:ubl-2.1-customizations:v1.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:piaozone.com:profile:bill:v1.0</cbc:ProfileID>
    <cbc:ID>TC004-AE-INV-2026-001</cbc:ID>
    <cbc:IssueDate>2026-09-09</cbc:IssueDate>
    <cbc:DueDate>2026-10-09</cbc:DueDate>
    <!-- IBT-003=380, BTAE-02=00000000 -->
    <cbc:InvoiceTypeCode name="00000000">380</cbc:InvoiceTypeCode>
    <!-- IBT-005: 货币=USD（非AED，须提供汇率） -->
    <cbc:DocumentCurrencyCode>USD</cbc:DocumentCurrencyCode>
    <!-- IBT-006: Tax currency = AED -->
    <cbc:TaxCurrencyCode>AED</cbc:TaxCurrencyCode>

    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="PEPPOL">0235:1005556667</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyIdentification>
                <cbc:ID schemeID="AE:LRA">Department of Economic Development - Dubai</cbc:ID>
            </cac:PartyIdentification>
            <cac:PostalAddress>
                <cbc:StreetName>Sheikh Zayed Road, Office 1201</cbc:StreetName>
                <cbc:CityName>Dubai</cbc:CityName>
                <cbc:CountrySubentity>DXB</cbc:CountrySubentity>
                <cac:Country><cbc:IdentificationCode>AE</cbc:IdentificationCode></cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>100555666700003</cbc:CompanyID>
                <cac:TaxScheme><cbc:ID>VAT</cbc:ID></cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Acme Trading LLC</cbc:RegistrationName>
                <cbc:CompanyID schemeID="AE:TL">CN-1234567</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="PEPPOL">0235:1007778889</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyIdentification>
                <cbc:ID schemeID="AE:LRA">Abu Dhabi Department of Economic Development</cbc:ID>
            </cac:PartyIdentification>
            <cac:PostalAddress>
                <cbc:StreetName>Khalifa Street, Tower 5</cbc:StreetName>
                <cbc:CityName>Abu Dhabi</cbc:CityName>
                <cbc:CountrySubentity>AUH</cbc:CountrySubentity>
                <cac:Country><cbc:IdentificationCode>AE</cbc:IdentificationCode></cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>100777888900003</cbc:CompanyID>
                <cac:TaxScheme><cbc:ID>VAT</cbc:ID></cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Burj Holdings PJSC</cbc:RegistrationName>
                <cbc:CompanyID schemeID="AE:TL">CN-1001003</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <cac:PaymentMeans>
        <cbc:PaymentMeansCode>30</cbc:PaymentMeansCode>
        <cac:PayeeFinancialAccount>
            <cbc:ID>AE070331234567890123456</cbc:ID>
            <cac:FinancialInstitutionBranch><cbc:ID>EBILAEAD</cbc:ID></cac:FinancialInstitutionBranch>
        </cac:PayeeFinancialAccount>
    </cac:PaymentMeans>

    <!-- BTAE-04: 汇率 6位小数，通过 TaxExchangeRate 表达 -->
    <cac:TaxExchangeRate>
        <cbc:SourceCurrencyCode>USD</cbc:SourceCurrencyCode>
        <cbc:TargetCurrencyCode>AED</cbc:TargetCurrencyCode>
        <cbc:CalculationRate>3.672500</cbc:CalculationRate>
        <cbc:MathematicOperatorCode>Multiply</cbc:MathematicOperatorCode>
    </cac:TaxExchangeRate>

    <!-- 主税额 USD（第一个TaxTotal含TaxSubtotal完整明细） -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="USD">50.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="USD">1000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="USD">50.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>5.00</cbc:Percent>
                <cac:TaxScheme><cbc:ID>VAT</cbc:ID></cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <!-- 计税货币AED税额（第二个TaxTotal，仅总额） -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="AED">183.63</cbc:TaxAmount>
    </cac:TaxTotal>

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="USD">1000.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="USD">1000.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="USD">1050.00</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="USD">1050.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="EA">10</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="USD">1000.00</cbc:LineExtensionAmount>
        <!-- 双TaxTotal：原币USD + AED（KDUBL-R-TAX-002） -->
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="USD">50.00</cbc:TaxAmount>
        </cac:TaxTotal>
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="AED">183.63</cbc:TaxAmount>
        </cac:TaxTotal>
        <cac:Item>
            <cbc:Name>Industrial pump</cbc:Name>
            <cac:CommodityClassification>
                <cbc:CommodityCode>G</cbc:CommodityCode>
                <cbc:ItemClassificationCode listID="HS">8413.70.10</cbc:ItemClassificationCode>
            </cac:CommodityClassification>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>5.00</cbc:Percent>
                <cac:TaxScheme><cbc:ID>VAT</cbc:ID></cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price><cbc:PriceAmount currencyID="USD">100.00</cbc:PriceAmount></cac:Price>
    </cac:InvoiceLine>
</Invoice>
