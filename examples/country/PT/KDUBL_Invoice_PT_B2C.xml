<?xml version="1.0" encoding="UTF-8"?>
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">

    <!-- Portugal (PT) KDUBL Invoice - B2C 简化发票（消费者 consumidor final） -->
    <!-- 买方税号 999999990 = AT 消费者占位，< 1000 EUR 由 eezi 自动按简化发票处理 -->
    <!-- IVA standard rate: 23% -->

    <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
    <cbc:CustomizationID>urn:piaozone.com:ubl-2.1-customizations:v1.0</cbc:CustomizationID>
    <cbc:ProfileID>urn:piaozone.com:profile:bill:v1.0</cbc:ProfileID>

    <cbc:ID>PT-INV-B2C-2026-001</cbc:ID>
    <cbc:IssueDate>2026-09-01</cbc:IssueDate>
    <cbc:IssueTime>10:15:00+00:00</cbc:IssueTime>
    <cbc:InvoiceTypeCode>380</cbc:InvoiceTypeCode>
    <cbc:DocumentCurrencyCode>EUR</cbc:DocumentCurrencyCode>

    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">B2C</cbc:ID>
        <cbc:DocumentType>InvoiceContext</cbc:DocumentType>
    </cac:AdditionalDocumentReference>
    <cac:AdditionalDocumentReference>
        <cbc:ID schemeName="InvoiceTag">false</cbc:ID>
        <cbc:DocumentType>SelfBilled</cbc:DocumentType>
    </cac:AdditionalDocumentReference>

    <!-- Supplier: Kingdee Test Supplier PT -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PartyName>
                <cbc:Name>Kingdee Test Supplier PT</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Avenida da Liberdade 110</cbc:StreetName>
                <cbc:CityName>Lisboa</cbc:CityName>
                <cbc:PostalZone>1269-046</cbc:PostalZone>
                <cbc:CountrySubentity>Lisboa</cbc:CountrySubentity>
                <cac:Country>
                    <cbc:IdentificationCode>PT</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>512345678</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Kingdee Test Supplier PT</cbc:RegistrationName>
                <cbc:CompanyID>512345678</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- Buyer: 消费者（consumidor final），税号用 AT 占位 999999990 -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PartyName>
                <cbc:Name>Consumidor Final</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Rua Augusta 100</cbc:StreetName>
                <cbc:CityName>Lisboa</cbc:CityName>
                <cbc:PostalZone>1100-048</cbc:PostalZone>
                <cac:Country>
                    <cbc:IdentificationCode>PT</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cbc:CompanyID>999999990</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>Consumidor Final</cbc:RegistrationName>
                <cbc:CompanyID>999999990</cbc:CompanyID>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- TaxTotal: 30 EUR * 23% = 6.90 EUR -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="EUR">6.90</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="EUR">30.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="EUR">6.90</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>23.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="EUR">30.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="EUR">30.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="EUR">36.90</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="EUR">36.90</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- Line 1: qty=2, price=15 EUR, net=30 EUR, S 23% -->
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">2</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="EUR">30.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Consumable Item</cbc:Description>
            <cbc:Name>Consumable Item</cbc:Name>
            <cac:SellersItemIdentification>
                <cbc:ID>CONS-001</cbc:ID>
            </cac:SellersItemIdentification>
            <cac:ClassifiedTaxCategory>
                <cbc:ID>S</cbc:ID>
                <cbc:Percent>23.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="EUR">15.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>

</Invoice>
